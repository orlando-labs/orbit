package ember.http_selftest

import ember
import task
from net.http import Client, RequestBody, Server

export main

def hello(request, name):
  ember.render(
    json: {
      greeting: "hello " + name,
      query: request.query(:source),
      request_id: request.header("x-request-id")
    },
    headers: {"x-ember": "yes"})

def events(request):
  ember.stream(
    headers: {"content-type": "text/event-stream"},
    trailers: ["x-stream-state"]) |body|:
      body.write("event: one\n\n", extensions: [["sequence", "1"]])
      body.write("event: two\n\n")
      body.close
      body.trailer("x-stream-state", "complete")
      body.finish

def echo(request):
  ember.stream(trailers: ["x-echo-state"]) |body|:
    request.body_stream.each_chunk |chunk|:
      body.write(chunk.bytes, extensions: chunk.extensions)
    body.close
    body.trailer("x-echo-state", "complete")
    body.finish

routes = ember.routes:
  get "/hello/:name", to: &hello, as: :hello
  get "/events", to: &events
  post "/echo", to: &echo

def assert(condition, message):
  raise ArgumentError(message) unless condition

def main():
  app = ember.App(routes: routes, expose_exceptions: true)
  server = Server(
    host: "127.0.0.1",
    port: 0,
    workers: 1,
    max_concurrent_per_worker: 2)
  port = server.port()
  runner = task.spawn:
    server.serve(max_requests: 3) |request|:
      app.call(request).to_server_response

  response = Client().get(
    "http://127.0.0.1:#{port}/hello/Amber?source=loopback",
    headers: {"x-request-id": "http-selftest"})
  body = response.body_text()

  events_response = Client().get("http://127.0.0.1:#{port}/events")
  events_body = events_response.body_text()
  events_trailer = events_response.body.trailers.first("x-stream-state")

  payload = RequestBody.stream(length: null) |writer|:
    writer.write_all!("left".bytes)
    writer.write_all!("right".bytes)
  echo_response = Client().post(
    "http://127.0.0.1:#{port}/echo",
    body: payload)
  echo_body = echo_response.body_text()
  echo_trailer = echo_response.body.trailers.first("x-echo-state")
  runner.wait

  assert(response.status == 200, "loopback status")
  assert(response.headers.first("content-type") == "application/json; charset=utf-8", "loopback type")
  assert(response.headers.first("x-ember") == "yes", "loopback response header")
  assert(body.contains?("hello Amber"), "loopback route capture")
  assert(body.contains?("loopback"), "loopback query parsing")
  assert(body.contains?("http-selftest"), "loopback request header")
  assert(events_response.headers.first("transfer-encoding") == "chunked", "stream chunked framing")
  assert(events_body == "event: one\n\nevent: two\n\n", "stream body")
  assert(events_trailer == "complete", "stream response trailer")
  assert(echo_body == "leftright", "streaming request echo")
  assert(echo_trailer == "complete", "echo response trailer")
  true
