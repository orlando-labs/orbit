        {"id": "reading", "title": "Input for POST /reading", "kind": "input"}
      ]
    },
    {
      "id": "server_board",
      "kind": "board",
      "title": "HTTP Server Board",
      "detail": "Orbit server and an isolated reading monitor",
      "symbol": "rectangle.inset.filled",
