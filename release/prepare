#!/bin/sh
set -eu

release_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sdk_root=$(CDPATH= cd -- "${SPUTNIK_ROOT:-$release_dir/../../sputnik-lang}" && pwd)
sputnik="$sdk_root/build/sputnik"
exec "$sputnik" run "$release_dir/prepare.s" \
    --grant fs.read --grant fs.write --grant fs.metadata --grant process.spawn \
    -- --release "$release_dir" --sdk "$sdk_root" "$@"
