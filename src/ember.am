class EmberError < Exception:
  attr message

  def init(@message as Str)
  def to_str():
    @message
  def str():
    @message

class RouteError < EmberError
class InvalidRouteError < RouteError
class DuplicateRouteError < RouteError
class DuplicateRouteNameError < RouteError
