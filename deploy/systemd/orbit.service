[Unit]
Description=Orbit application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orbit
Group=orbit
WorkingDirectory=/opt/orbit/current
ExecStart=/opt/orbit/current/bin/app
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orbit
EnvironmentFile=/etc/orbit/app.env

[Install]
WantedBy=multi-user.target
