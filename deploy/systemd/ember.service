[Unit]
Description=Ember application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ember
Group=ember
WorkingDirectory=/opt/ember/current
ExecStart=/opt/ember/current/bin/app
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ember
EnvironmentFile=/etc/ember/app.env

[Install]
WantedBy=multi-user.target
